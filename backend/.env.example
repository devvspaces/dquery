# Server Configuration
NODE_ENV=development
PORT=3001
# Bind address (production uses 127.0.0.1 behind nginx)
HOST=0.0.0.0
API_PREFIX=api

# Database Configuration
DATABASE_URL=postgresql://domainq:domainq_dev_password@localhost:5432/domainq

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# LLM API Configuration
# Choose your preferred LLM provider: openai, anthropic, or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
LLM_OPENAI_MODEL=gpt-4-turbo
LLM_ANTHROPIC_MODEL=claude-opus-5-5
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30000

# Registrar Configuration
# Comma-separated list of enabled registrars (godaddy,namecheap,cloudflare,spaceship,porkbun)
# Leave empty to enable all. Providers without credentials are skipped automatically.
ENABLED_REGISTRARS=godaddy,namecheap,cloudflare,spaceship,porkbun
# Order in which providers are tried for the (single) availability check per domain.
# Availability is decided by the registry, so one answer is enough; later ones are fallbacks.
AVAILABILITY_CHECKER_ORDER=cloudflare,namecheap,spaceship,godaddy
# Daily TLD price-catalog sync (cron, UTC)
PRICE_SYNC_CRON=15 3 * * *

# Registrar API Keys
GODADDY_API_KEY=your-godaddy-api-key
GODADDY_API_SECRET=your-godaddy-api-secret
GODADDY_API_URL=https://api.godaddy.com
# Note: GoDaddy's availability API only works for accounts with 50+ domains.

NAMECHEAP_API_USER=your-namecheap-api-user
NAMECHEAP_API_KEY=your-namecheap-api-key
NAMECHEAP_USERNAME=your-namecheap-username
NAMECHEAP_CLIENT_IP=your-whitelisted-ip
NAMECHEAP_API_URL=https://api.namecheap.com/xml.response

CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
# Set to "registrar-sandbox" to test against Cloudflare's sandbox
CLOUDFLARE_REGISTRAR_PATH=registrar

SPACESHIP_API_KEY=your-spaceship-api-key
SPACESHIP_API_SECRET=your-spaceship-api-secret
SPACESHIP_API_URL=https://spaceship.dev/api/v1

# Porkbun needs no credentials: its price list endpoint is public.

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Cache Configuration
DOMAIN_CACHE_TTL=900
PRICING_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Credits (prices are in credits; see CreditPricingService)
# One AI generation run / one word-engine run
CREDIT_PER_AI_GENERATION=1
CREDIT_PER_WORD_GENERATION=0.25
# Each name x TLD checked, full registrar comparison included
CREDIT_PER_DOMAIN_CHECK=0.05
# Sign-up grant: first FREE_CREDITS_EARLY_LIMIT users get FREE_CREDITS_EARLY, then FREE_CREDITS_DEFAULT
FREE_CREDITS_EARLY=10
FREE_CREDITS_EARLY_LIMIT=500
FREE_CREDITS_DEFAULT=5

# Comma-separated emails allowed to use admin/debug endpoints
ADMIN_EMAILS=

# Queue Configuration
QUEUE_GENERATION_CONCURRENCY=2
QUEUE_CHECKING_CONCURRENCY=10
QUEUE_GENERATION_TIMEOUT=60000
QUEUE_CHECKING_TIMEOUT=30000
QUEUE_REMOVE_ON_COMPLETE_AGE=3600
QUEUE_REMOVE_ON_FAIL_AGE=86400
